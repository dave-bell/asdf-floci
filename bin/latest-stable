#!/usr/bin/env bash

set -euo pipefail

current_script_path=${BASH_SOURCE[0]}
plugin_dir=$(dirname "$(dirname "$current_script_path")")

# shellcheck source=./lib/utils.bash
source "${plugin_dir}/lib/utils.bash"

# All floci-cli tags observed to date are plain, stable semver releases (no
# "-rc"/"-beta" pre-release tags), so "latest stable" is just the highest
# version, optionally filtered by the query asdf core passes us.
query="${1:-}"

version="$(list_all_versions | sort_versions | grep -e "^${query}" | tail -n1)"

[ -n "$version" ] || fail "No versions found matching '$query'"

printf "%s\n" "$version"
